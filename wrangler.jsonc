{
  // AGI Zeitgeist Tracker: a static site served by a Cloudflare Worker.
  // Build the page first (.venv/bin/python scripts/site.py), then `npx wrangler deploy`.
  // The Worker script only redirects the spare names to agizeitgeist.com; every
  // request on the main name is served straight from the site/ folder.
  "name": "agi-zeitgeist",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "agizeitgeist.com", "custom_domain": true },
    { "pattern": "www.agizeitgeist.com", "custom_domain": true },
    { "pattern": "zeitgeist.sentient-horizons.com", "custom_domain": true }
  ]
}
